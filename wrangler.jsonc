{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sensorx-website",
  "main": "_worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
